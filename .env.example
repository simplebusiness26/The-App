# Supabase project this app talks to. The-App uses its own project ("Xplorer"),
# separate from the project Guest-book-V3 uses.
# Values come from Supabase dashboard -> Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Demo logins, for showing the prototype to somebody. Tap the Xplorer wordmark
# on the login screen five times and the account list appears.
#
# LEAVE BOTH EMPTY FOR ANY BUILD YOU PUBLISH. They are the only thing that puts
# a working password into the app, so an empty value means there is no password
# in the bundle to find -- not a hidden one. The panel says so if you open it.
#
# EXPO_PUBLIC_DEMO_PASSWORD is shared by every demo account.
# EXPO_PUBLIC_DEMO_ADMIN_EMAIL is optional: set it and an Admin button appears,
# leave it out and there is no admin login and no admin address in the bundle.
EXPO_PUBLIC_DEMO_PASSWORD=
EXPO_PUBLIC_DEMO_ADMIN_EMAIL=

# Base URL used to build the password-reset redirect: app/auth/forgot-password.js
# sends users to {EXPO_PUBLIC_APP_URL}/auth/update-password.
# Optional on web, where it falls back to window.location.origin. Whatever you set
# must also be allowlisted under Supabase -> Authentication -> URL Configuration.
EXPO_PUBLIC_APP_URL=

# Routing provider for Directions. Leave empty to use the free public Valhalla
# server run by FOSSGIS (valhalla1.openstreetmap.de).
#
# Their terms are the same fair-use policy as the OSRM and Nominatim demo
# servers, enforced with rate limits, and they ask that published apps identify
# themselves -- Xplorer sends an X-Client-Id header. Before this goes to real
# users at any scale, either tell them via their GitHub Discussions or point
# this at your own instance. Self-hosting Valhalla is a Docker image and an
# OpenStreetMap extract; changing provider entirely means one file,
# utils/routing/valhalla.js.
EXPO_PUBLIC_ROUTING_URL=
