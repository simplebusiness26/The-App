{
  "name": "guestbook",
  "version": "1.0.0",
  "description": "Local discovery app for Airbnb guests",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "verify:social": "node scripts/verify-social-layer.cjs",
    "verify:live": "node scripts/verify-linkups-live.cjs && node scripts/verify-linkups-hardening.cjs",
    "verify:screens": "node scripts/verify-screen-gates.cjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.14",
    "@supabase/supabase-js": "latest",
    "expo": "~57.0.9",
    "expo-camera": "latest",
    "expo-constants": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.7",
    "expo-router": "~57.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "latest",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
