{
  "name": "guestbook",
  "version": "1.0.0",
  "description": "Local discovery app for Airbnb guests",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "verify:social": "node scripts/verify-social-layer.cjs",
    "verify:live": "node scripts/verify-linkups-live.cjs && node scripts/verify-linkups-hardening.cjs",
    "verify:screens": "node scripts/verify-screen-gates.cjs",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "verify:taxonomy": "node scripts/verify-taxonomy.cjs",
    "verify:markers": "node scripts/verify-marker-assignment.cjs",
    "verify:place": "node scripts/verify-place-layout.cjs",
    "verify:cards": "node scripts/verify-map-cards.cjs",
    "verify:discover": "node scripts/verify-discover.cjs",
    "verify:reputation": "node scripts/verify-review-reputation.cjs",
    "verify:places": "node scripts/verify-place-follows.cjs",
    "verify:memories": "node scripts/verify-memories.cjs",
    "verify:mymap": "node scripts/verify-my-map.cjs",
    "verify:livingmap": "node scripts/verify-living-map.cjs",
    "verify:browser": "node scripts/verify-browser.cjs",
    "verify:trending": "node scripts/verify-trending.cjs",
    "verify:score": "node scripts/verify-score-engine.cjs",
    "verify:manager": "node scripts/verify-manager-boundary.cjs",
    "verify:listings": "node scripts/verify-listing-creation-gate.cjs",
    "verify:permissions": "node scripts/verify-one-permission-point.cjs",
    "verify:friends": "node scripts/verify-friends-visibility.cjs",
    "verify:contrast": "node scripts/verify-contrast.cjs",
    "verify:nativemap": "node scripts/verify-native-map-props.cjs"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-navigation/native": "^7.3.14",
    "@supabase/supabase-js": "latest",
    "expo": "~57.0.10",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.7",
    "expo-router": "~57.0.10",
    "maplibre-gl": "^5.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "latest",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "react-test-renderer": "^19.2.3"
  }
}
